<!--
    More events for the vanilla Crystal homeworld sector. See
    sector_data.xml.append.
-->

<eventList name="XFTL_MORE_CRYSTAL">
	<event load="XFTL_CRYSTAL_RESONANCE"/>
	<event load="XFTL_CRYSTAL_GUARDIAN"/>
	<event load="XFTL_CRYSTAL_SHARDS"/>
</eventList>

<event name="XFTL_CRYSTAL_RESONANCE">
	<text id="event_XFTL_CRYSTAL_RESONANCE_text"/>
	<choice>
		<text id="event_XFTL_CRYSTAL_RESONANCE_c1_choice"/>
		<event load="XFTL_CRYSTAL_RESONANCE_OUTCOME"/>
	</choice>
	<choice req="crystal" hidden="true">
		<text id="event_XFTL_CRYSTAL_RESONANCE_c2_choice"/>
		<event>
			<text id="event_XFTL_CRYSTAL_RESONANCE_c2_text"/>
			<autoReward level="HIGH">scrap_only</autoReward>
		</event>
	</choice>
	<choice>
		<text id="event_XFTL_CRYSTAL_RESONANCE_c3_choice"/>
		<event/>
	</choice>
</event>
<eventList name="XFTL_CRYSTAL_RESONANCE_OUTCOME">
	<event>
		<text id="event_XFTL_CRYSTAL_RESONANCE_OUTCOME_1_text"/>
		<upgrade amount="1" system="reactor"/>
	</event>
	<event>
		<text id="event_XFTL_CRYSTAL_RESONANCE_OUTCOME_2_text"/>
		<damage amount="2" system="random"/>
	</event>
</eventList>

<event name="XFTL_CRYSTAL_GUARDIAN">
	<text id="event_XFTL_CRYSTAL_GUARDIAN_text"/>
	<choice>
		<text id="event_XFTL_CRYSTAL_GUARDIAN_c1_choice"/>
		<event>
			<text id="event_XFTL_CRYSTAL_GUARDIAN_c1_text"/>
		</event>
	</choice>
	<choice>
		<text id="event_XFTL_CRYSTAL_GUARDIAN_c2_choice"/>
		<event>
			<text id="event_XFTL_CRYSTAL_GUARDIAN_c2_text"/>
			<ship load="XFTL_CRYSTAL_GUARDIAN_SHIP" hostile="true"/>
		</event>
	</choice>
</event>
<ship name="XFTL_CRYSTAL_GUARDIAN_SHIP" auto_blueprint="SHIPS_CRYSTAL">
	<destroyed>
		<text id="ship_XFTL_CRYSTAL_GUARDIAN_SHIP_destroyed_text"/>
		<weapon name="RANDOM"/>
		<autoReward level="MED">standard</autoReward>
	</destroyed>
	<deadCrew>
		<text id="ship_XFTL_CRYSTAL_GUARDIAN_SHIP_deadCrew_text"/>
		<autoReward level="HIGH">standard</autoReward>
	</deadCrew>
</ship>

<event name="XFTL_CRYSTAL_SHARDS">
	<text id="event_XFTL_CRYSTAL_SHARDS_text"/>
	<choice>
		<text id="event_XFTL_CRYSTAL_SHARDS_c1_choice"/>
		<event>
			<text id="event_XFTL_CRYSTAL_SHARDS_c1_text"/>
			<crewMember amount="1" class="crystal"/>
		</event>
	</choice>
	<choice>
		<text id="event_XFTL_CRYSTAL_SHARDS_c2_choice"/>
		<event/>
	</choice>
</event>
