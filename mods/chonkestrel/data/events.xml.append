<!--
    The events of the campaign's second act, and the Blockade Line between the
    two acts, and the hints of what's coming in act 1. See
    sector_data.xml.append, and doc/game/lore.md for the story: the Rebels' AI,
    CONCORD, has taken over their fleet, and is joining the galaxy into one
    mind with its signal, the hum (the Chorus).
-->


<!--
********************
THE BLOCKADE LINE (the midpoint)
********************
-->

<event name="XFTL_BLOCKADE_START">
	<text id="event_XFTL_BLOCKADE_START_text"/>
	<img back="BACKGROUND" planet="NONE"/>
</event>

<event name="XFTL_BLOCKADE_EXIT">
	<text id="event_XFTL_BLOCKADE_EXIT_text"/>
	<choice>
		<text id="event_XFTL_BLOCKADE_EXIT_c1_choice"/>
		<event>
			<text id="event_XFTL_BLOCKADE_EXIT_c1_text"/>
			<ship load="XFTL_BLOCKADE_COMMAND" hostile="true"/>
		</event>
	</choice>
	<choice req="xftl_ship_size" lvl="2" hidden="true">
		<text id="event_XFTL_BLOCKADE_EXIT_c2_choice"/>
		<event>
			<text id="event_XFTL_BLOCKADE_EXIT_c2_text"/>
			<autoReward level="LOW" xftlScale="size">stuff</autoReward>
			<xftlBossOpening>noSuperShield</xftlBossOpening>
			<ship load="XFTL_BLOCKADE_COMMAND" hostile="true"/>
		</event>
	</choice>
	<choice req="cloaking" hidden="true">
		<text id="event_XFTL_BLOCKADE_EXIT_c3_choice"/>
		<event>
			<text id="event_XFTL_BLOCKADE_EXIT_c3_text"/>
			<xftlBossOpening>ambush</xftlBossOpening>
			<ship load="XFTL_BLOCKADE_COMMAND" hostile="true"/>
		</event>
	</choice>
</event>

<!-- The Vigilance: the size 3 boss at the end of act 1 (see doc/game/bosses.md) -->
<ship name="XFTL_BLOCKADE_COMMAND" blueprint="XFTL_BOSS_VIGILANCE">
	<destroyed>
		<text id="ship_XFTL_BLOCKADE_COMMAND_destroyed_text"/>
		<xftlBossReward tier="2" weapon="XFTL_X2_LASER_HEAVY_2" augment="XFTL_COMMAND_CODES"/>
		<choice>
			<text id="ship_XFTL_BLOCKADE_COMMAND_destroyed_c1_choice"/>
			<event load="XFTL_BLOCKADE_REVEAL"/>
		</choice>
	</destroyed>
	<deadCrew>
		<text id="ship_XFTL_BLOCKADE_COMMAND_deadCrew_text"/>
		<xftlBossReward tier="2" weapon="XFTL_X2_LASER_HEAVY_2" augment="XFTL_COMMAND_CODES"/>
		<choice>
			<text id="ship_XFTL_BLOCKADE_COMMAND_deadCrew_c1_choice"/>
			<event load="XFTL_BLOCKADE_REVEAL"/>
		</choice>
	</deadCrew>
</ship>

<!-- What really happened: the story's turn, between the two acts -->
<event name="XFTL_BLOCKADE_REVEAL">
	<text id="event_XFTL_BLOCKADE_REVEAL_text"/>
	<choice>
		<text id="event_XFTL_BLOCKADE_REVEAL_c1_choice"/>
		<event load="XFTL_BLOCKADE_REVEAL_REVIC"/>
	</choice>
</event>
<event name="XFTL_BLOCKADE_REVEAL_REVIC">
	<text id="event_XFTL_BLOCKADE_REVEAL_REVIC_text"/>
	<choice>
		<text id="event_XFTL_BLOCKADE_REVEAL_REVIC_c1_choice"/>
		<event load="XFTL_BLOCKADE_REVEAL_END"/>
	</choice>
</event>
<event name="XFTL_BLOCKADE_REVEAL_END">
	<text id="event_XFTL_BLOCKADE_REVEAL_END_text"/>
	<choice>
		<text id="event_XFTL_BLOCKADE_REVEAL_END_c1_choice"/>
		<event>
			<text id="event_XFTL_BLOCKADE_REVEAL_END_c1_text"/>
		</event>
	</choice>
	<choice req="xftl_ship_size" lvl="2" hidden="true">
		<text id="event_XFTL_BLOCKADE_REVEAL_END_c2_choice"/>
		<event>
			<text id="event_XFTL_BLOCKADE_REVEAL_END_c2_text"/>
		</event>
	</choice>
</event>

<textList name="XFTL_BLOCKADE_PATROL">
	<text id="text_XFTL_BLOCKADE_PATROL_1"/>
	<text id="text_XFTL_BLOCKADE_PATROL_2"/>
	<text id="text_XFTL_BLOCKADE_PATROL_3"/>
	<text id="text_XFTL_BLOCKADE_PATROL_4"/>
</textList>
<event name="XFTL_BLOCKADE_PATROL">
	<text load="XFTL_BLOCKADE_PATROL"/>
	<ship load="REBEL" hostile="true"/>
</event>

<event name="XFTL_BLOCKADE_SMUGGLER">
	<text id="event_XFTL_BLOCKADE_SMUGGLER_text"/>
	<choice>
		<text id="event_XFTL_BLOCKADE_SMUGGLER_c1_choice"/>
		<event>
			<text id="event_XFTL_BLOCKADE_SMUGGLER_c1_text"/>
			<item_modify>
				<item type="scrap" min="-30" max="-30"/>
			</item_modify>
			<reveal_map/>
		</event>
	</choice>
	<choice>
		<text id="event_XFTL_BLOCKADE_SMUGGLER_c2_choice"/>
		<event>
			<text id="event_XFTL_BLOCKADE_SMUGGLER_c2_text"/>
		</event>
	</choice>
</event>

<event name="XFTL_BLOCKADE_DEFECTOR">
	<text id="event_XFTL_BLOCKADE_DEFECTOR_text"/>
	<choice>
		<text id="event_XFTL_BLOCKADE_DEFECTOR_c1_choice"/>
		<event load="XFTL_BLOCKADE_DEFECTOR_OUTCOME"/>
	</choice>
	<choice>
		<text id="event_XFTL_BLOCKADE_DEFECTOR_c2_choice"/>
		<event>
			<text id="event_XFTL_BLOCKADE_DEFECTOR_c2_text"/>
		</event>
	</choice>
</event>
<eventList name="XFTL_BLOCKADE_DEFECTOR_OUTCOME">
	<event>
		<text id="event_XFTL_BLOCKADE_DEFECTOR_OUTCOME_1_text"/>
		<crewMember amount="1" class="human"/>
	</event>
	<event>
		<text id="event_XFTL_BLOCKADE_DEFECTOR_OUTCOME_2_text"/>
		<crewMember amount="1"/>
	</event>
	<event>
		<text id="event_XFTL_BLOCKADE_DEFECTOR_OUTCOME_3_text"/>
		<ship load="REBEL" hostile="true"/>
	</event>
</eventList>

<event name="XFTL_BLOCKADE_REFUGEES">
	<text id="event_XFTL_BLOCKADE_REFUGEES_text"/>
	<choice>
		<text id="event_XFTL_BLOCKADE_REFUGEES_c1_choice"/>
		<event>
			<text id="event_XFTL_BLOCKADE_REFUGEES_c1_text"/>
			<item_modify>
				<item type="fuel" min="-2" max="-2"/>
			</item_modify>
			<crewMember amount="1"/>
		</event>
	</choice>
	<choice>
		<text id="event_XFTL_BLOCKADE_REFUGEES_c2_choice"/>
		<event>
			<text id="event_XFTL_BLOCKADE_REFUGEES_c2_text"/>
		</event>
	</choice>
</event>


<!--
********************
FREE COLONIES (XFTL_FEDERATION_REMNANT)
