		<text id="event_XFTL_REMNANT_DRYDOCK_c1_choice"/>
		<event>
			<text id="event_XFTL_REMNANT_DRYDOCK_c1_text"/>
			<item_modify xftlScale="size">
				<item type="scrap" min="-15" max="-15"/>
			</item_modify>
			<damage amount="-8" xftlScale="size"/>
		</event>
	</choice>
	<choice>
		<text id="event_XFTL_REMNANT_DRYDOCK_c2_choice"/>
