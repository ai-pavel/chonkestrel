			<damage amount="-30" xftlScale="size"/>
		</event>
	</choice>
	<choice>
		<text id="event_XFTL_REMNANT_DRYDOCK_c3_choice"/>
		<event/>
	</choice>
</event>

<textList name="XFTL_REMNANT_VOLUNTEERS">
