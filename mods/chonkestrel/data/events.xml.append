	</deadCrew>
</ship>

<!--
    The vanilla sectors' own start events, for those that shared one: the
    plain ones that had the generic START_BEACON, the homeworlds (which had
    their race's sector's) and the Rebel sector with the miniboss. Every
    sector's start beacon just describes it, with at most a plain nebula
    (see GameMap.calmStart).
-->
<event name="XFTL_START_CIVILIAN">
	<text id="event_XFTL_START_CIVILIAN_text"/>
</event>
<event name="XFTL_START_STANDARD">
	<text id="event_XFTL_START_STANDARD_text"/>
</event>
<event name="XFTL_START_DEEP_SPACE">
	<text id="event_XFTL_START_DEEP_SPACE_text"/>
</event>
<event name="XFTL_START_ABANDONED">
	<text id="event_XFTL_START_ABANDONED_text"/>
</event>
<event name="XFTL_START_ENGI_HOME">
	<text id="event_XFTL_START_ENGI_HOME_text"/>
</event>
<event name="XFTL_START_MANTIS_HOME">
	<text id="event_XFTL_START_MANTIS_HOME_text"/>
</event>
<event name="XFTL_START_ROCK_HOME">
	<text id="event_XFTL_START_ROCK_HOME_text"/>
</event>
<event name="XFTL_START_SLUG_HOME">
	<text id="event_XFTL_START_SLUG_HOME_text"/>
	<environment type="nebula"/>
</event>
<event name="XFTL_START_ZOLTAN_HOME">
	<text id="event_XFTL_START_ZOLTAN_HOME_text"/>
</event>
<event name="XFTL_START_REBEL_MINIBOSS">
	<text id="event_XFTL_START_REBEL_MINIBOSS_text"/>
</event>

<!--
    The refuelling station's fuel (and its price) is for the player's ship's
    size (xftlScale), as a bigger ship takes more fuel a jump: twice as much
    for the Chonkestrel. Its choices say so (text_events.xml.append).
-->
<mod:findName type="event" name="REFUEL_STATION">
	<mod:findLike type="choice" limit="-1">
		<mod:findLike type="event">
			<mod:findLike type="item_modify">
				<mod:setAttributes xftlScale="size"/>
			</mod:findLike>
		</mod:findLike>
	</mod:findLike>
</mod:findName>

<!--
    A hybrid sector's CONCORD relay, the quest its start event marks (see
    tools/hybrid_sectors.py): its codes add to XFTL_CONCORD_CODES, and each
    one weakens the Mainframe (see ColossalBoss.relayCodes and
    doc/game/mainframe.md). Its guard is one of the sector's hybrids, alone.
-->
<event name="XFTL_HYBRIDSEC_RELAY">
	<text id="event_XFTL_HYBRIDSEC_RELAY_text"/>
	<choice>
		<text id="event_XFTL_HYBRIDSEC_RELAY_c1_choice"/>
		<event>
			<text id="event_XFTL_HYBRIDSEC_RELAY_c1_text"/>
			<ship load="XFTL_HYBRIDSEC_RELAY_GUARD" hostile="true"/>
		</event>
	</choice>
	<choice req="hacking" hidden="true">
		<text id="event_XFTL_HYBRIDSEC_RELAY_c2_choice"/>
		<event>
			<text id="event_XFTL_HYBRIDSEC_RELAY_c2_text"/>
			<xftlCounter name="XFTL_CONCORD_CODES"/>
		</event>
	</choice>
	<choice req="engi" hidden="true">
		<text id="event_XFTL_HYBRIDSEC_RELAY_c3_choice"/>
		<event>
			<text id="event_XFTL_HYBRIDSEC_RELAY_c3_text"/>
			<xftlCounter name="XFTL_CONCORD_CODES"/>
		</event>
	</choice>
	<choice>
		<text id="event_XFTL_HYBRIDSEC_RELAY_c4_choice_2"/>
		<event/>
	</choice>
</event>

<ship name="XFTL_HYBRIDSEC_RELAY_GUARD" auto_blueprint="XFTL_HYBRID_SECTOR_SHIPS" xftlAlone="true">
	<destroyed>
		<text id="ship_XFTL_HYBRIDSEC_RELAY_GUARD_destroyed_text"/>
		<autoReward level="MED">standard</autoReward>
		<xftlCounter name="XFTL_CONCORD_CODES"/>
	</destroyed>
	<deadCrew>
		<text id="ship_XFTL_HYBRIDSEC_RELAY_GUARD_deadCrew_text"/>
		<autoReward level="HIGH">standard</autoReward>
		<xftlCounter name="XFTL_CONCORD_CODES"/>
	</deadCrew>
</ship>

