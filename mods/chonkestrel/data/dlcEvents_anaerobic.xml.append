<!--
    More events for the vanilla Lanius sector. See sector_data.xml.append.
-->

<eventList name="XFTL_MORE_LANIUS">
	<event load="XFTL_LANIUS_METAL_EATERS"/>
	<event load="XFTL_LANIUS_TRADE"/>
	<event load="XFTL_LANIUS_SLEEPER"/>
	<event load="XFTL_LANIUS_HULK"/>
</eventList>

<event name="XFTL_LANIUS_METAL_EATERS">
	<text id="event_XFTL_LANIUS_METAL_EATERS_text"/>
	<choice>
		<text id="event_XFTL_LANIUS_METAL_EATERS_c1_choice"/>
		<event>
			<text id="event_XFTL_LANIUS_METAL_EATERS_c1_text"/>
			<ship load="LANIUS_SHIP" hostile="true"/>
		</event>
	</choice>
	<choice>
		<text id="event_XFTL_LANIUS_METAL_EATERS_c2_choice"/>
		<event>
			<text id="event_XFTL_LANIUS_METAL_EATERS_c2_text"/>
			<item_modify>
				<item type="scrap" min="-15" max="-15"/>
			</item_modify>
			<crewMember amount="1" class="anaerobic"/>
		</event>
	</choice>
</event>

<event name="XFTL_LANIUS_TRADE">
	<text id="event_XFTL_LANIUS_TRADE_text"/>
	<choice>
		<text id="event_XFTL_LANIUS_TRADE_c1_choice"/>
		<event>
			<text id="event_XFTL_LANIUS_TRADE_c1_text"/>
			<item_modify>
				<item type="missiles" min="-3" max="-3"/>
				<item type="drones" min="3" max="4"/>
			</item_modify>
		</event>
	</choice>
	<choice>
		<text id="event_XFTL_LANIUS_TRADE_c2_choice"/>
		<event>
			<text id="event_XFTL_LANIUS_TRADE_c2_text"/>
			<item_modify>
				<item type="scrap" min="-20" max="-20"/>
				<item type="fuel" min="4" max="5"/>
			</item_modify>
		</event>
	</choice>
	<choice>
		<text id="event_XFTL_LANIUS_TRADE_c3_choice"/>
		<event/>
	</choice>
</event>

<event name="XFTL_LANIUS_SLEEPER">
	<text id="event_XFTL_LANIUS_SLEEPER_text"/>
	<choice>
		<text id="event_XFTL_LANIUS_SLEEPER_c1_choice"/>
		<event load="XFTL_LANIUS_SLEEPER_OUTCOME"/>
	</choice>
	<choice>
		<text id="event_XFTL_LANIUS_SLEEPER_c2_choice"/>
		<event>
			<text id="event_XFTL_LANIUS_SLEEPER_c2_text"/>
			<autoReward level="LOW">scrap_only</autoReward>
		</event>
	</choice>
	<choice>
		<text id="event_XFTL_LANIUS_SLEEPER_c3_choice"/>
		<event/>
	</choice>
</event>
<eventList name="XFTL_LANIUS_SLEEPER_OUTCOME">
	<event>
		<text id="event_XFTL_LANIUS_SLEEPER_OUTCOME_1_text"/>
		<crewMember amount="1" class="anaerobic"/>
	</event>
	<event>
		<text id="event_XFTL_LANIUS_SLEEPER_OUTCOME_2_text"/>
		<boarders min="1" max="1" class="anaerobic"/>
	</event>
</eventList>

<event name="XFTL_LANIUS_HULK">
	<text id="event_XFTL_LANIUS_HULK_text"/>
	<choice>
		<text id="event_XFTL_LANIUS_HULK_c1_choice"/>
		<event load="XFTL_LANIUS_HULK_OUTCOME"/>
	</choice>
	<choice>
		<text id="event_XFTL_LANIUS_HULK_c2_choice"/>
		<event/>
	</choice>
</event>
<eventList name="XFTL_LANIUS_HULK_OUTCOME">
	<event>
		<text id="event_XFTL_LANIUS_HULK_OUTCOME_1_text"/>
		<weapon name="RANDOM"/>
	</event>
	<event>
		<text id="event_XFTL_LANIUS_HULK_OUTCOME_2_text"/>
		<ship load="LANIUS_SHIP" hostile="true"/>
	</event>
	<event>
		<text id="event_XFTL_LANIUS_HULK_OUTCOME_3_text"/>
		<item_modify>
			<item type="fuel" min="2" max="3"/>
		</item_modify>
	</event>
</eventList>
