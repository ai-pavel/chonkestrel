<!--
    More events for the vanilla Mantis sectors. See sector_data.xml.append.
-->

<eventList name="XFTL_MORE_MANTIS">
	<event load="XFTL_MANTIS_HUNT"/>
	<event load="XFTL_MANTIS_ARENA"/>
	<event load="XFTL_MANTIS_HATCHERY"/>
	<event load="XFTL_MANTIS_OUTCAST"/>
</eventList>

<event name="XFTL_MANTIS_HUNT">
	<text id="event_XFTL_MANTIS_HUNT_text"/>
	<choice>
		<text id="event_XFTL_MANTIS_HUNT_c1_choice"/>
		<event>
			<text id="event_XFTL_MANTIS_HUNT_c1_text"/>
			<ship load="XFTL_MANTIS_HUNTERS" hostile="true"/>
		</event>
	</choice>
	<choice>
		<text id="event_XFTL_MANTIS_HUNT_c2_choice"/>
		<event>
			<text id="event_XFTL_MANTIS_HUNT_c2_text"/>
		</event>
	</choice>
</event>
<ship name="XFTL_MANTIS_HUNTERS" auto_blueprint="SHIPS_MANTIS">
	<destroyed>
		<text id="ship_XFTL_MANTIS_HUNTERS_destroyed_text"/>
		<autoReward level="MED">standard</autoReward>
	</destroyed>
	<deadCrew>
		<text id="ship_XFTL_MANTIS_HUNTERS_deadCrew_text"/>
		<crewMember amount="1" class="human"/>
		<autoReward level="LOW">standard</autoReward>
	</deadCrew>
</ship>

<event name="XFTL_MANTIS_ARENA">
	<text id="event_XFTL_MANTIS_ARENA_text"/>
	<choice>
		<text id="event_XFTL_MANTIS_ARENA_c1_choice"/>
		<event load="XFTL_MANTIS_ARENA_OUTCOME"/>
	</choice>
	<choice req="mantis" hidden="true">
		<text id="event_XFTL_MANTIS_ARENA_c2_choice"/>
		<event>
			<text id="event_XFTL_MANTIS_ARENA_c2_text"/>
			<autoReward level="HIGH">standard</autoReward>
		</event>
	</choice>
	<choice req="rock" hidden="true">
		<text id="event_XFTL_MANTIS_ARENA_c3_choice"/>
		<event>
			<text id="event_XFTL_MANTIS_ARENA_c3_text"/>
			<autoReward level="MED">standard</autoReward>
		</event>
	</choice>
	<choice>
		<text id="event_XFTL_MANTIS_ARENA_c4_choice"/>
		<event>
			<text id="event_XFTL_MANTIS_ARENA_c4_text"/>
			<ship load="MANTIS_FIGHT" hostile="true"/>
		</event>
	</choice>
</event>
<eventList name="XFTL_MANTIS_ARENA_OUTCOME">
	<event>
		<text id="event_XFTL_MANTIS_ARENA_OUTCOME_1_text"/>
		<autoReward level="MED">standard</autoReward>
	</event>
	<event>
		<text id="event_XFTL_MANTIS_ARENA_OUTCOME_2_text"/>
		<item_modify>
			<item type="scrap" min="-10" max="-10"/>
		</item_modify>
	</event>
</eventList>

<event name="XFTL_MANTIS_HATCHERY">
	<text id="event_XFTL_MANTIS_HATCHERY_text"/>
	<choice>
		<text id="event_XFTL_MANTIS_HATCHERY_c1_choice"/>
		<event>
			<text id="event_XFTL_MANTIS_HATCHERY_c1_text"/>
			<ship load="MANTIS_FIGHT" hostile="true"/>
		</event>
	</choice>
	<choice>
		<text id="event_XFTL_MANTIS_HATCHERY_c2_choice"/>
		<event>
			<text id="event_XFTL_MANTIS_HATCHERY_c2_text"/>
		</event>
	</choice>
</event>

<event name="XFTL_MANTIS_OUTCAST">
	<text id="event_XFTL_MANTIS_OUTCAST_text"/>
	<choice>
		<text id="event_XFTL_MANTIS_OUTCAST_c1_choice"/>
		<event load="XFTL_MANTIS_OUTCAST_OUTCOME"/>
	</choice>
	<choice>
		<text id="event_XFTL_MANTIS_OUTCAST_c2_choice"/>
		<event/>
	</choice>
</event>
<eventList name="XFTL_MANTIS_OUTCAST_OUTCOME">
	<event>
		<text id="event_XFTL_MANTIS_OUTCAST_OUTCOME_1_text"/>
		<crewMember amount="1" class="mantis"/>
	</event>
	<event>
		<text id="event_XFTL_MANTIS_OUTCAST_OUTCOME_2_text"/>
		<crewMember amount="1" class="mantis"/>
	</event>
	<event>
		<text id="event_XFTL_MANTIS_OUTCAST_OUTCOME_3_text"/>
		<boarders min="1" max="1" class="mantis"/>
		<ship load="MANTIS_FIGHT" hostile="true"/>
	</event>
</eventList>
