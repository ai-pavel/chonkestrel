<!--
    Each nebula sector's quest (see doc/game/sectors.md): its start event
    marks the first beacon, which leads on to the second, where the reward
    is, an augment found nowhere else. Quests can go in this kind of
    sector's nebulas (see Sector.addQuest).
-->

<!-- The Radiation Fields: the research station, and its lab at the core -->
<event name="XFTL_RADFIELDS_STATION">
	<text id="event_XFTL_RADFIELDS_STATION_text"/>
	<choice>
		<text id="event_XFTL_RADFIELDS_STATION_c1_choice"/>
		<event>
			<text id="event_XFTL_RADFIELDS_STATION_c1_text"/>
			<autoReward level="LOW">stuff</autoReward>
			<damage amount="1"/>
			<quest event="XFTL_RADFIELDS_CORE" xftlAhead="true"/>
		</event>
	</choice>
	<choice req="rock" hidden="true">
		<text id="event_XFTL_RADFIELDS_STATION_c2_choice"/>
		<event>
			<text id="event_XFTL_RADFIELDS_STATION_c2_text"/>
			<autoReward level="MED">stuff</autoReward>
			<quest event="XFTL_RADFIELDS_CORE" xftlAhead="true"/>
		</event>
	</choice>
	<choice>
		<text id="event_XFTL_RADFIELDS_STATION_c3_choice"/>
		<event/>
	</choice>
</event>

<event name="XFTL_RADFIELDS_CORE">
