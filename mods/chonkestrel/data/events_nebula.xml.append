<!--
    More events for the vanilla nebula sectors. See sector_data.xml.append.
-->

<eventList name="XFTL_MORE_NEBULA">
	<event load="XFTL_NEBULA_SIGNAL"/>
	<event load="XFTL_NEBULA_COLLISION"/>
	<event load="XFTL_NEBULA_GAS_HARVEST"/>
	<event load="XFTL_NEBULA_HIDING_FLEET"/>
</eventList>

<event name="XFTL_NEBULA_SIGNAL">
	<text id="event_XFTL_NEBULA_SIGNAL_text"/>
	<environment type="nebula"/>
	<choice>
		<text id="event_XFTL_NEBULA_SIGNAL_c1_choice"/>
		<event load="XFTL_NEBULA_SIGNAL_OUTCOME"/>
	</choice>
	<choice>
		<text id="event_XFTL_NEBULA_SIGNAL_c2_choice"/>
		<event/>
	</choice>
</event>
<eventList name="XFTL_NEBULA_SIGNAL_OUTCOME">
	<event>
		<text id="event_XFTL_NEBULA_SIGNAL_OUTCOME_1_text"/>
		<autoReward level="MED">stuff</autoReward>
	</event>
	<event>
		<text id="event_XFTL_NEBULA_SIGNAL_OUTCOME_2_text"/>
		<autoReward level="LOW">standard</autoReward>
	</event>
	<event>
		<text id="event_XFTL_NEBULA_SIGNAL_OUTCOME_3_text"/>
		<ship load="REBEL" hostile="true"/>
	</event>
</eventList>

<event name="XFTL_NEBULA_COLLISION">
	<text id="event_XFTL_NEBULA_COLLISION_text"/>
	<environment type="nebula"/>
	<choice>
		<text id="event_XFTL_NEBULA_COLLISION_c1_choice"/>
		<event load="XFTL_NEBULA_COLLISION_OUTCOME"/>
	</choice>
	<choice req="pilot" lvl="2" hidden="true">
		<text id="event_XFTL_NEBULA_COLLISION_c2_choice"/>
		<event>
			<text id="event_XFTL_NEBULA_COLLISION_c2_text"/>
			<autoReward level="LOW">standard</autoReward>
		</event>
	</choice>
</event>
<eventList name="XFTL_NEBULA_COLLISION_OUTCOME">
	<event>
		<text id="event_XFTL_NEBULA_COLLISION_OUTCOME_1_text"/>
	</event>
	<event>
		<text id="event_XFTL_NEBULA_COLLISION_OUTCOME_2_text"/>
		<damage amount="2"/>
	</event>
</eventList>

<event name="XFTL_NEBULA_GAS_HARVEST">
	<text id="event_XFTL_NEBULA_GAS_HARVEST_text"/>
	<environment type="nebula"/>
	<choice>
		<text id="event_XFTL_NEBULA_GAS_HARVEST_c1_choice"/>
		<event>
			<text id="event_XFTL_NEBULA_GAS_HARVEST_c1_text"/>
			<item_modify>
				<item type="fuel" min="2" max="4"/>
			</item_modify>
			<modifyPursuit amount="1"/>
		</event>
	</choice>
	<choice>
		<text id="event_XFTL_NEBULA_GAS_HARVEST_c2_choice"/>
		<event/>
	</choice>
</event>

<event name="XFTL_NEBULA_HIDING_FLEET">
	<text id="event_XFTL_NEBULA_HIDING_FLEET_text"/>
	<environment type="nebula"/>
	<choice>
		<text id="event_XFTL_NEBULA_HIDING_FLEET_c1_choice"/>
		<event>
			<text id="event_XFTL_NEBULA_HIDING_FLEET_c1_text"/>
			<item_modify>
				<item type="fuel" min="-2" max="-2"/>
				<item type="missiles" min="-1" max="-1"/>
			</item_modify>
			<crewMember amount="1"/>
		</event>
	</choice>
	<choice>
		<text id="event_XFTL_NEBULA_HIDING_FLEET_c2_choice"/>
		<event/>
	</choice>
</event>


