<?xml version="1.0" encoding="utf-8"?>
<!--
    The Chonkestrel's layout, based on the vanilla Kestrel's (kestral.xml,
    copyright (c) 2012 by Subset Games). See chonkestrel.txt for the rooms.

    The ship is made 140px (four rows of rooms) taller than the Kestrel, by
    stretching the middle of the hull. The cockpit bump on the nose is moved
    down to the middle of the nose, by the pilot, in the hull, cloak and nose
    gib (gib6) images. The airlock bracket at the top of the rear is mirrored
    at the bottom (lit from below, like the rest of the hull), in the hull,
    cloak and rear gib (gib1) images.
-->
<FTL>

<img x="-59" y="-103" w="652" h="558"/>

<offsets>
	<floor x="45" y="93"/>
	<cloak x="19" y="19"/>
</offsets>

<!--
    The weapon mounts, placed so all eight weapons stick out past the
    taller hull. Each side has four, stepped down towards the nose (which
    narrows) so none of them look like they're shooting another: on the
    engine pod, on the widened bump, at the back of the nose and at its tip.
    The bottom mounts mirror the top ones.

    The first four are used by the first weapons system, and the last four
    by the second.
-->
<weaponMounts>
    <mount x="588" y="162" rotate="true" mirror="true" gib="6" slide="up"/>
    <mount x="588" y="395" rotate="true" mirror="false" gib="6" slide="down"/>
    <mount x="440" y="145" rotate="true" mirror="true" gib="6" slide="up"/>
    <mount x="440" y="412" rotate="true" mirror="false" gib="6" slide="down"/>

    <mount x="345" y="79" rotate="true" mirror="true" gib="5" slide="up"/>
    <mount x="345" y="478" rotate="true" mirror="false" gib="5" slide="down"/>
    <mount x="140" y="40" rotate="true" mirror="true" gib="2" slide="up"/>
    <mount x="140" y="517" rotate="true" mirror="false" gib="2" slide="down"/>
</weaponMounts>

<explosion>
	<gib1>
		<velocity min="0.6" max="1"/>
		<direction min="60" max="120"/>
		<angular min="-0.4" max="-0.1"/>
		<x>-5</x>
		<y>114</y>
	</gib1>
	<gib2>
		<velocity min="0" max="0.4"/>
		<direction min="0" max="90"/>
		<angular min="-0.4" max="0"/>
		<x>25</x>
		<y>23</y>
	</gib2>
	<gib3>
		<velocity min="0.5" max="1"/>
		<direction min="-40" max="90"/>
		<angular min="-0.5" max="1"/>
		<x>35</x>
		<y>-7</y>
	</gib3>
	<gib4>
		<velocity min="0.4" max="1"/>
		<direction min="120" max="200"/>
		<angular min= "-0.2" max="1"/>
		<x>38</x>
		<y>193</y>
	</gib4>
	<gib5>
		<velocity min="0" max="0.5"/>
		<direction min="230" max="310"/>
		<angular min= "-0.2" max="0.2"/>
		<x>174</x>
		<y>44</y>
	</gib5>
	<gib6>
		<velocity min="0.6" max="1"/>
		<direction min="240" max="300"/>
		<angular min= "-1" max="1"/>
		<x>375</x>
		<y>107</y>
	</gib6>
</explosion>
</FTL>
