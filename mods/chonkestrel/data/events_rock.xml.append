<!--
    More events for the vanilla Rock sectors. See sector_data.xml.append.
-->

<eventList name="XFTL_MORE_ROCK">
	<event load="XFTL_ROCK_MINE"/>
	<event load="XFTL_ROCK_PREACHER"/>
	<event load="XFTL_ROCK_LAVA_FORGE"/>
	<event load="XFTL_ROCK_BLOCKADE"/>
</eventList>

<event name="XFTL_ROCK_MINE">
	<text id="event_XFTL_ROCK_MINE_text"/>
	<environment type="asteroid"/>
	<choice>
		<text id="event_XFTL_ROCK_MINE_c1_choice"/>
		<event load="XFTL_ROCK_MINE_OUTCOME"/>
	</choice>
	<choice>
		<text id="event_XFTL_ROCK_MINE_c2_choice"/>
		<event>
			<text id="event_XFTL_ROCK_MINE_c2_text"/>
			<crewMember amount="1" class="rock"/>
		</event>
	</choice>
	<choice>
		<text id="event_XFTL_ROCK_MINE_c3_choice"/>
		<event/>
	</choice>
</event>
<eventList name="XFTL_ROCK_MINE_OUTCOME">
	<event>
		<text id="event_XFTL_ROCK_MINE_OUTCOME_1_text"/>
		<item_modify>
			<item type="scrap" min="10" max="25"/>
		</item_modify>
	</event>
	<event>
		<text id="event_XFTL_ROCK_MINE_OUTCOME_2_text"/>
		<item_modify>
			<item type="scrap" min="-10" max="-10"/>
		</item_modify>
	</event>
</eventList>

<event name="XFTL_ROCK_PREACHER">
	<text id="event_XFTL_ROCK_PREACHER_text"/>
	<choice>
		<text id="event_XFTL_ROCK_PREACHER_c1_choice"/>
		<event>
			<text id="event_XFTL_ROCK_PREACHER_c1_text"/>
			<item_modify>
				<item type="scrap" min="-15" max="-15"/>
			</item_modify>
			<crewMember amount="1" class="rock"/>
		</event>
	</choice>
	<choice>
		<text id="event_XFTL_ROCK_PREACHER_c2_choice"/>
		<event>
			<text id="event_XFTL_ROCK_PREACHER_c2_text"/>
			<ship load="ROCK_SHIP" hostile="true"/>
		</event>
	</choice>
	<choice>
		<text id="event_XFTL_ROCK_PREACHER_c3_choice"/>
		<event/>
	</choice>
</event>

<event name="XFTL_ROCK_LAVA_FORGE">
	<text id="event_XFTL_ROCK_LAVA_FORGE_text"/>
	<choice>
		<text id="event_XFTL_ROCK_LAVA_FORGE_c1_choice"/>
		<event>
			<text id="event_XFTL_ROCK_LAVA_FORGE_c1_text"/>
			<item_modify>
				<item type="scrap" min="-25" max="-25"/>
			</item_modify>
			<damage amount="-8"/>
		</event>
	</choice>
	<choice req="rock" hidden="true">
		<text id="event_XFTL_ROCK_LAVA_FORGE_c2_choice"/>
		<event>
			<text id="event_XFTL_ROCK_LAVA_FORGE_c2_text"/>
			<damage amount="-8"/>
		</event>
	</choice>
	<choice>
		<text id="event_XFTL_ROCK_LAVA_FORGE_c3_choice"/>
		<event/>
	</choice>
</event>

<event name="XFTL_ROCK_BLOCKADE">
	<text id="event_XFTL_ROCK_BLOCKADE_text"/>
	<choice>
		<text id="event_XFTL_ROCK_BLOCKADE_c1_choice"/>
		<event load="XFTL_ROCK_BLOCKADE_OUTCOME"/>
	</choice>
	<choice>
		<text id="event_XFTL_ROCK_BLOCKADE_c2_choice"/>
		<event>
			<text id="event_XFTL_ROCK_BLOCKADE_c2_text"/>
			<ship load="ROCK_SHIP" hostile="true"/>
		</event>
	</choice>
</event>
<eventList name="XFTL_ROCK_BLOCKADE_OUTCOME">
	<event>
		<text id="event_XFTL_ROCK_BLOCKADE_OUTCOME_1_text"/>
	</event>
	<event>
		<text id="event_XFTL_ROCK_BLOCKADE_OUTCOME_2_text"/>
		<item_modify>
			<item type="missiles" min="-2" max="-2"/>
			<item type="drones" min="-1" max="-1"/>
		</item_modify>
	</event>
	<event>
		<text id="event_XFTL_ROCK_BLOCKADE_OUTCOME_3_text"/>
		<ship load="ROCK_SHIP" hostile="true"/>
	</event>
</eventList>
