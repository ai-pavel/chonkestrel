<!--
    More events for the vanilla civilian sectors, so a sixteen-sector game
    doesn't keep repeating the same ones. See sector_data.xml.append.
-->

<eventList name="XFTL_MORE_CIVILIAN">
	<event load="XFTL_CIV_FERRY"/>
	<event load="XFTL_CIV_RACE"/>
	<event load="XFTL_CIV_MEDICAL"/>
	<event load="XFTL_CIV_ARCHIVIST"/>
	<event load="XFTL_CIV_DESERTER"/>
</eventList>

<textList name="XFTL_CIV_FERRY">
	<text id="text_XFTL_CIV_FERRY_1"/>
	<text id="text_XFTL_CIV_FERRY_2"/>
</textList>
<event name="XFTL_CIV_FERRY">
	<text load="XFTL_CIV_FERRY"/>
	<choice>
		<text id="event_XFTL_CIV_FERRY_c1_choice"/>
		<event load="XFTL_CIV_FERRY_FIX"/>
	</choice>
	<choice req="engi" hidden="true">
		<text id="event_XFTL_CIV_FERRY_c2_choice"/>
		<event>
			<text id="event_XFTL_CIV_FERRY_c2_text"/>
			<autoReward level="MED">standard</autoReward>
		</event>
	</choice>
	<choice>
		<text id="event_XFTL_CIV_FERRY_c3_choice"/>
		<event/>
	</choice>
</event>
<eventList name="XFTL_CIV_FERRY_FIX">
	<event>
		<text id="event_XFTL_CIV_FERRY_FIX_1_text"/>
		<autoReward level="LOW">scrap_only</autoReward>
	</event>
	<event>
		<text id="event_XFTL_CIV_FERRY_FIX_2_text"/>
		<crewMember amount="1" class="human"/>
	</event>
	<event>
		<text id="event_XFTL_CIV_FERRY_FIX_3_text"/>
		<damage amount="2"/>
	</event>
</eventList>

<event name="XFTL_CIV_RACE">
	<text id="event_XFTL_CIV_RACE_text"/>
	<choice>
		<text id="event_XFTL_CIV_RACE_c1_choice"/>
		<event load="XFTL_CIV_RACE_OUTCOME"/>
	</choice>
	<choice req="engines" lvl="4" hidden="true">
		<text id="event_XFTL_CIV_RACE_c2_choice"/>
		<event>
			<text id="event_XFTL_CIV_RACE_c2_text"/>
			<item_modify>
				<item type="scrap" min="25" max="35"/>
			</item_modify>
		</event>
	</choice>
	<choice>
		<text id="event_XFTL_CIV_RACE_c3_choice"/>
		<event/>
	</choice>
</event>
<eventList name="XFTL_CIV_RACE_OUTCOME">
	<event>
		<text id="event_XFTL_CIV_RACE_OUTCOME_1_text"/>
		<item_modify>
			<item type="scrap" min="15" max="25"/>
		</item_modify>
	</event>
	<event>
		<text id="event_XFTL_CIV_RACE_OUTCOME_2_text"/>
		<item_modify>
			<item type="scrap" min="-10" max="-10"/>
		</item_modify>
	</event>
	<event>
		<text id="event_XFTL_CIV_RACE_OUTCOME_3_text"/>
		<item_modify>
			<item type="scrap" min="-10" max="-10"/>
		</item_modify>
		<damage amount="2"/>
	</event>
</eventList>

<event name="XFTL_CIV_MEDICAL">
	<text id="event_XFTL_CIV_MEDICAL_text"/>
	<choice>
		<text id="event_XFTL_CIV_MEDICAL_c1_choice"/>
		<event>
			<text id="event_XFTL_CIV_MEDICAL_c1_text"/>
			<autoReward level="LOW">stuff</autoReward>
		</event>
	</choice>
	<choice req="medbay" lvl="2" hidden="true">
		<text id="event_XFTL_CIV_MEDICAL_c2_choice"/>
		<event>
			<text id="event_XFTL_CIV_MEDICAL_c2_text"/>
			<crewMember amount="1" class="human" pilot="1"/>
		</event>
	</choice>
	<choice>
		<text id="event_XFTL_CIV_MEDICAL_c3_choice"/>
		<event/>
	</choice>
</event>

<event name="XFTL_CIV_ARCHIVIST">
	<text id="event_XFTL_CIV_ARCHIVIST_text"/>
	<choice>
		<text id="event_XFTL_CIV_ARCHIVIST_c1_choice"/>
		<event load="XFTL_CIV_ARCHIVIST_SHARE"/>
	</choice>
	<choice>
		<text id="event_XFTL_CIV_ARCHIVIST_c2_choice"/>
		<event>
			<text id="event_XFTL_CIV_ARCHIVIST_c2_text"/>
			<item_modify>
				<item type="scrap" min="-30" max="-30"/>
			</item_modify>
			<weapon name="RANDOM"/>
		</event>
	</choice>
	<choice>
		<text id="event_XFTL_CIV_ARCHIVIST_c3_choice"/>
		<event/>
	</choice>
</event>

<!--
    Sharing the ship's data with the archivist: the star chart either way,
    but half the time the archivist sells the data on, and an ambush is
    waiting at one of the sector's beacons (or the next sector's), unmarked
    (a hidden quest, xftlHidden): XFTL_CIV_ARCHIVIST_AMBUSH. The only hint's
    in the text.
-->
<eventList name="XFTL_CIV_ARCHIVIST_SHARE">
	<event>
		<text id="event_XFTL_CIV_ARCHIVIST_c1_text"/>
		<reveal_map/>
	</event>
	<event>
		<text id="event_XFTL_CIV_ARCHIVIST_c1_sold_text"/>
		<reveal_map/>
		<quest event="XFTL_CIV_ARCHIVIST_AMBUSH" xftlHidden="true"/>
	</event>
</eventList>

<!--
    The ambush: bounty hunters who bought the ship's data, and know its weak
    spots, so they hit first (a system hit and a breach, more for a bigger
    ship). A cloak, a hacking system or an Engi gets the ship away unseen.
-->
<event name="XFTL_CIV_ARCHIVIST_AMBUSH">
	<text id="event_XFTL_CIV_ARCHIVIST_AMBUSH_text"/>
	<choice>
		<text id="event_XFTL_CIV_ARCHIVIST_AMBUSH_c1_choice"/>
		<event>
			<text id="event_XFTL_CIV_ARCHIVIST_AMBUSH_c1_text"/>
			<ship load="PIRATE" hostile="true"/>
			<damage amount="2" system="random" effect="breach" xftlScale="size"/>
		</event>
	</choice>
	<choice req="cloaking" hidden="true">
		<text id="event_XFTL_CIV_ARCHIVIST_AMBUSH_c2_choice"/>
		<event>
			<text id="event_XFTL_CIV_ARCHIVIST_AMBUSH_c2_text"/>
		</event>
	</choice>
	<choice req="hacking" hidden="true">
		<text id="event_XFTL_CIV_ARCHIVIST_AMBUSH_c3_choice"/>
		<event>
			<text id="event_XFTL_CIV_ARCHIVIST_AMBUSH_c3_text"/>
		</event>
	</choice>
	<choice req="engi" hidden="true">
		<text id="event_XFTL_CIV_ARCHIVIST_AMBUSH_c4_choice"/>
		<event>
			<text id="event_XFTL_CIV_ARCHIVIST_AMBUSH_c4_text"/>
		</event>
	</choice>
</event>

<event name="XFTL_CIV_DESERTER">
	<text id="event_XFTL_CIV_DESERTER_text"/>
	<choice>
		<text id="event_XFTL_CIV_DESERTER_c1_choice"/>
		<event load="XFTL_CIV_DESERTER_OUTCOME"/>
	</choice>
	<choice>
		<text id="event_XFTL_CIV_DESERTER_c2_choice"/>
		<event/>
	</choice>
</event>
<eventList name="XFTL_CIV_DESERTER_OUTCOME">
	<event>
		<text id="event_XFTL_CIV_DESERTER_OUTCOME_1_text"/>
		<crewMember amount="1" class="human" combat="1"/>
	</event>
	<event>
		<text id="event_XFTL_CIV_DESERTER_OUTCOME_2_text"/>
		<ship load="REBEL" hostile="true"/>
	</event>
</eventList>

<!--
    The fuel seller's fuel (and its price) is for the player's ship's size
    (xftlScale), as for the refuelling station (see events.xml.append).
-->
<mod:findName type="event" name="FUEL_SELLER_DISTRESS">
	<mod:findLike type="choice" limit="-1">
		<mod:findLike type="event">
			<mod:findLike type="item_modify">
				<mod:setAttributes xftlScale="size"/>
			</mod:findLike>
		</mod:findLike>
	</mod:findLike>
</mod:findName>
