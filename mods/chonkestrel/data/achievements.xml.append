<!--
    The achievements for each of the mod's player ships: six each, the same
    three for every ship (beating the Vigilance, winning, and winning on
    Hard), and three for its race, shared by its Type A and B but separate
    achievements (except the Federation's and the Stealth ships', whose Type
    A and B have three each of their own). The ships are in the hangar's
    order (see hangar/ShipList), which the achievements window keeps. See
    doc/game/achievements.md.

    These are vanilla's achievements, with an XFTL extension, the goal XFTL
    tracks through a game to unlock it (see AchievementTracker):
    <xftlGoal kind="..." target="N"/>. The target's the number to reach (a
    default for the kind if it's left out), and it goes in the description
    in place of \1, so it's only in one place. The images are made by
    tools/achievement_art.py, which reads this file.
-->

<!-- The Chonkestrel -->
<achievement id="XFTL_ACH_CHONKESTREL_1">
    <name>Blockade Breaker</name>
    <desc>Beat the RSV Vigilance at the Blockade Line with the Chonkestrel.</desc>
    <img>achievements/xftl_chonkestrel_1.png</img>
    <ship>PLAYER_SHIP_CHONKESTREL</ship>
    <xftlGoal kind="blockade"/>
</achievement>
<achievement id="XFTL_ACH_CHONKESTREL_2">
    <name>Mainframe Down</name>
    <desc>Destroy CONCORD's Mainframe and win the game with the Chonkestrel.</desc>
    <img>achievements/xftl_chonkestrel_2.png</img>
    <ship>PLAYER_SHIP_CHONKESTREL</ship>
    <xftlGoal kind="win"/>
</achievement>
<achievement id="XFTL_ACH_CHONKESTREL_3">
    <name>Against All Odds</name>
    <desc>Win the game on Hard with the Chonkestrel.</desc>
    <img>achievements/xftl_chonkestrel_3.png</img>
    <ship>PLAYER_SHIP_CHONKESTREL</ship>
    <xftlGoal kind="winHard"/>
</achievement>
<achievement id="XFTL_ACH_CHONKESTREL_4">
    <name>Outnumbered</name>
    <desc>Win a fight against \1 ships at once, destroying them or killing their crew.</desc>
    <img>achievements/xftl_chonkestrel_4.png</img>
    <ship>PLAYER_SHIP_CHONKESTREL</ship>
    <xftlGoal kind="fleetFight" target="3"/>
</achievement>
<achievement id="XFTL_ACH_CHONKESTREL_5">
    <name>Steady Hands</name>
    <desc>Beat a boss without the hull going below \1% in that fight.</desc>
    <img>achievements/xftl_chonkestrel_5.png</img>
    <ship>PLAYER_SHIP_CHONKESTREL</ship>
    <xftlGoal kind="bossHull" target="50"/>
</achievement>
<achievement id="XFTL_ACH_CHONKESTREL_6">
    <name>Full House</name>
    <desc>Win the game with \1 crew alive.</desc>
    <img>achievements/xftl_chonkestrel_6.png</img>
    <ship>PLAYER_SHIP_CHONKESTREL</ship>
    <xftlGoal kind="crewAtWin" target="16"/>
</achievement>

