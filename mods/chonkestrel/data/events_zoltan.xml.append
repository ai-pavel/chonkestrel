<!--
    More events for the vanilla Zoltan sectors. See sector_data.xml.append.
-->

<eventList name="XFTL_MORE_ZOLTAN">
	<event load="XFTL_ZOLTAN_PILGRIMS"/>
	<event load="XFTL_ZOLTAN_TRIAL"/>
	<event load="XFTL_ZOLTAN_ENERGY_MARKET"/>
	<event load="XFTL_ZOLTAN_PEACEKEEPERS"/>
</eventList>

<event name="XFTL_ZOLTAN_PILGRIMS">
	<text id="event_XFTL_ZOLTAN_PILGRIMS_text"/>
	<choice>
		<text id="event_XFTL_ZOLTAN_PILGRIMS_c1_choice"/>
		<event>
			<text id="event_XFTL_ZOLTAN_PILGRIMS_c1_text"/>
			<item_modify>
				<item type="fuel" min="-2" max="-2"/>
			</item_modify>
			<crewMember amount="1" class="energy"/>
		</event>
	</choice>
	<choice req="energy" hidden="true">
		<text id="event_XFTL_ZOLTAN_PILGRIMS_c2_choice"/>
		<event>
			<text id="event_XFTL_ZOLTAN_PILGRIMS_c2_text"/>
			<autoReward level="MED">stuff</autoReward>
		</event>
	</choice>
	<choice>
		<text id="event_XFTL_ZOLTAN_PILGRIMS_c3_choice"/>
		<event>
			<text id="event_XFTL_ZOLTAN_PILGRIMS_c3_text"/>
		</event>
	</choice>
</event>

<event name="XFTL_ZOLTAN_TRIAL">
	<text id="event_XFTL_ZOLTAN_TRIAL_text"/>
	<choice>
		<text id="event_XFTL_ZOLTAN_TRIAL_c1_choice"/>
		<event load="XFTL_ZOLTAN_TRIAL_OUTCOME"/>
	</choice>
	<choice>
		<text id="event_XFTL_ZOLTAN_TRIAL_c2_choice"/>
		<event>
			<text id="event_XFTL_ZOLTAN_TRIAL_c2_text"/>
			<ship load="ZOLTAN_SHIP" hostile="true"/>
		</event>
	</choice>
</event>
<eventList name="XFTL_ZOLTAN_TRIAL_OUTCOME">
	<event>
		<text id="event_XFTL_ZOLTAN_TRIAL_OUTCOME_1_text"/>
		<autoReward level="MED">standard</autoReward>
	</event>
	<event>
		<text id="event_XFTL_ZOLTAN_TRIAL_OUTCOME_2_text"/>
		<item_modify>
			<item type="scrap" min="-10" max="-10"/>
		</item_modify>
	</event>
	<event>
		<text id="event_XFTL_ZOLTAN_TRIAL_OUTCOME_3_text"/>
		<modifyPursuit amount="1"/>
	</event>
</eventList>

<event name="XFTL_ZOLTAN_ENERGY_MARKET">
	<text id="event_XFTL_ZOLTAN_ENERGY_MARKET_text"/>
	<choice>
		<text id="event_XFTL_ZOLTAN_ENERGY_MARKET_c1_choice"/>
		<event>
			<text id="event_XFTL_ZOLTAN_ENERGY_MARKET_c1_text"/>
			<item_modify>
				<item type="scrap" min="-40" max="-40"/>
			</item_modify>
			<upgrade amount="1" system="reactor"/>
		</event>
	</choice>
	<choice req="battery" hidden="true">
		<text id="event_XFTL_ZOLTAN_ENERGY_MARKET_c2_choice"/>
		<event>
			<text id="event_XFTL_ZOLTAN_ENERGY_MARKET_c2_text"/>
			<autoReward level="MED">scrap_only</autoReward>
		</event>
	</choice>
	<choice>
		<text id="event_XFTL_ZOLTAN_ENERGY_MARKET_c3_choice"/>
		<event/>
	</choice>
</event>

<event name="XFTL_ZOLTAN_PEACEKEEPERS">
	<text id="event_XFTL_ZOLTAN_PEACEKEEPERS_text"/>
	<choice>
		<text id="event_XFTL_ZOLTAN_PEACEKEEPERS_c1_choice"/>
		<event>
			<text id="event_XFTL_ZOLTAN_PEACEKEEPERS_c1_text"/>
			<ship load="XFTL_ZOLTAN_REBEL_INTRUDER" hostile="true"/>
		</event>
	</choice>
	<choice>
		<text id="event_XFTL_ZOLTAN_PEACEKEEPERS_c2_choice"/>
		<event/>
	</choice>
</event>
<ship name="XFTL_ZOLTAN_REBEL_INTRUDER" auto_blueprint="SHIPS_REBEL">
	<destroyed>
		<text id="ship_XFTL_ZOLTAN_REBEL_INTRUDER_destroyed_text"/>
		<autoReward level="HIGH">standard</autoReward>
	</destroyed>
	<deadCrew>
		<text id="ship_XFTL_ZOLTAN_REBEL_INTRUDER_deadCrew_text"/>
		<autoReward level="HIGH">standard</autoReward>
	</deadCrew>
</ship>
