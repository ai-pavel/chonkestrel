</eventList>

<event name="XFTL_REBEL_FALSE_FLAG">
	<text id="event_XFTL_REBEL_FALSE_FLAG_text"/>
	<choice>
		<text id="event_XFTL_REBEL_FALSE_FLAG_c1_choice"/>
		<event>
			<text id="event_XFTL_REBEL_FALSE_FLAG_c1_text"/>
			<ship load="REBEL" hostile="true"/>
			<damage amount="2"/>
		</event>
	</choice>
	<choice req="sensors" lvl="2" hidden="true">
		<text id="event_XFTL_REBEL_FALSE_FLAG_c2_choice"/>
		<event>
			<text id="event_XFTL_REBEL_FALSE_FLAG_c2_text"/>
			<ship load="REBEL" hostile="true"/>
		</event>
	</choice>
	<choice>
		<text id="event_XFTL_REBEL_FALSE_FLAG_c3_choice"/>
		<event/>
	</choice>
</event>

<event name="XFTL_REBEL_COURIER">
	<text id="event_XFTL_REBEL_COURIER_text"/>
	<choice>
		<text id="event_XFTL_REBEL_COURIER_c1_choice"/>
		<event>
			<text id="event_XFTL_REBEL_COURIER_c1_text"/>
			<ship load="XFTL_REBEL_COURIER_SHIP" hostile="true"/>
		</event>
	</choice>
	<choice>
		<text id="event_XFTL_REBEL_COURIER_c2_choice"/>
		<event/>
	</choice>
</event>
<ship name="XFTL_REBEL_COURIER_SHIP" auto_blueprint="SHIPS_REBEL">
	<escape timer="40" min="4" max="6"/>
	<gotaway>
		<text id="ship_XFTL_REBEL_COURIER_SHIP_gotaway_text"/>
		<modifyPursuit amount="1"/>
	</gotaway>
	<destroyed>
		<text id="ship_XFTL_REBEL_COURIER_SHIP_destroyed_text"/>
		<reveal_map/>
		<autoReward level="LOW">standard</autoReward>
	</destroyed>
	<deadCrew>
		<text id="ship_XFTL_REBEL_COURIER_SHIP_deadCrew_text"/>
		<reveal_map/>
		<autoReward level="MED">standard</autoReward>
	</deadCrew>
</ship>

