<text name="xftl_ship_FED_SCOUT_P_LONG_class">Langer Piraten-Aufklärer</text>
<text name="xftl_ship_FED_SCOUT_WIDE_class">Breiter Föderationsaufklärer</text>
<text name="xftl_ship_FED_SCOUT_P_WIDE_class">Breiter Piraten-Aufklärer</text>
