<text name="ship_XFTL_BOSS_VIGILANCE_name">RSV Vigilance</text>
<text name="ship_XFTL_BOSS_STORMBREAKER_class">CONCORD-Jäger-Flaggschiff</text>
<text name="ship_XFTL_BOSS_STORMBREAKER_name">Sturmbrecher</text>
