<text name="xftl_ship_REBEL_SKINNY_ELITE_LONG_class">Langer Elitejäger</text>
<text name="xftl_ship_REBEL_SKINNY_WIDE_class">Breiter Rebellen-Jäger</text>
<text name="xftl_ship_REBEL_SKINNY_ELITE_WIDE_class">Breiter Elitejäger</text>
