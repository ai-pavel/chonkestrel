<!--
    More crew names, as the Chonkestrel has room for sixteen crew and the
    game only has 169 English ones. These go in the first English lists of
    male and female names (the localised lists come later in the file, and
    have a language attribute), rather than new lists, since the game picks a
    list before picking a name from it, so a new list would make its names
    much more common than the others.

    There's 140 male and 29 female names, the same as vanilla's English ones,
    and none of them are already in the game.
-->
<mod:findLike type="nameList" limit="1">
    <mod:selector race="human" sex="male"/>
    <mod-append:name>Aarav</mod-append:name>
    <mod-append:name>Abel</mod-append:name>
    <mod-append:name>Ahmet</mod-append:name>
    <mod-append:name>Aiden</mod-append:name>
