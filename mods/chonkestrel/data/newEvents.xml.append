		<text id="event_XFTL_BIG_DOCKING_c1_choice"/>
		<event>
			<text id="event_XFTL_BIG_DOCKING_c1_text"/>
			<autoReward level="LOW">standard</autoReward>
		</event>
	</choice>
	<choice req="xftl_ship_size" lvl="2" hidden="true">
		<text id="event_XFTL_BIG_DOCKING_c2_choice"/>
		<event>
			<text id="event_XFTL_BIG_DOCKING_c2_text"/>
			<autoReward level="MED" xftlScale="size">scrap_only</autoReward>
		</event>
	</choice>
	<choice>
		<text id="event_XFTL_BIG_DOCKING_c3_choice"/>
		<event/>
	</choice>
</event>

<textList name="XFTL_BIG_FAME">
