<!--
    Hostile ships as big as the Chonkestrel (size 2), for the events written
    for big player ships (see newEvents.xml.append). These are used through
    the xftlBigBlueprint attribute of the events' ships, an XFTL extension.

    They're empty for now, so big player ships fight several copies of the
    vanilla ships instead (see Wingman.kt). Once there are size 2 ships, add
    them here, and every event using these lists will start using them.
-->
<blueprintList name="SHIPS_REBEL_SIZE2">
</blueprintList>
<blueprintList name="SHIPS_PIRATE_SIZE2">
</blueprintList>
<blueprintList name="SHIPS_AUTO_SIZE2">
</blueprintList>
<blueprintList name="SHIPS_MANTIS_SIZE2">
</blueprintList>
<blueprintList name="SHIPS_ROCK_SIZE2">
</blueprintList>

<!-- BEGIN generated by tools/ship_variants.py -->
<!--
    The bigger versions of the vanilla ships (see doc/game/ship-shapes.md). Don't
    edit these by hand: change tools/ship_variants.py and run it again.
-->
<shipBlueprint name="FED_SCOUT_LONG" layout="fed_scout_long" img="fed_scout_long">
