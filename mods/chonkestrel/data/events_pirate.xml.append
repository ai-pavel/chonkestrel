<!--
    More events for the vanilla pirate sectors. See sector_data.xml.append.
-->

<eventList name="XFTL_MORE_PIRATE">
	<event load="XFTL_PIRATE_AUCTION"/>
	<event load="XFTL_PIRATE_DUEL"/>
	<event load="XFTL_PIRATE_RANSOM"/>
	<event load="XFTL_PIRATE_TOLL"/>
	<event load="XFTL_PIRATE_MUTINY"/>
</eventList>

<event name="XFTL_PIRATE_AUCTION">
	<text id="event_XFTL_PIRATE_AUCTION_text"/>
	<choice>
		<text id="event_XFTL_PIRATE_AUCTION_c1_choice"/>
		<event load="XFTL_PIRATE_AUCTION_OUTCOME"/>
	</choice>
	<choice>
		<text id="event_XFTL_PIRATE_AUCTION_c2_choice"/>
		<event>
			<text id="event_XFTL_PIRATE_AUCTION_c2_text"/>
			<item_modify>
				<item type="scrap" min="-25" max="-25"/>
			</item_modify>
			<crewMember amount="1"/>
		</event>
	</choice>
	<choice>
		<text id="event_XFTL_PIRATE_AUCTION_c3_choice"/>
		<event/>
	</choice>
</event>
<eventList name="XFTL_PIRATE_AUCTION_OUTCOME">
	<event>
		<text id="event_XFTL_PIRATE_AUCTION_OUTCOME_1_text"/>
		<item_modify>
			<item type="scrap" min="-30" max="-30"/>
		</item_modify>
		<weapon name="RANDOM"/>
	</event>
	<event>
		<text id="event_XFTL_PIRATE_AUCTION_OUTCOME_2_text"/>
		<item_modify>
			<item type="scrap" min="-30" max="-30"/>
			<item type="missiles" min="1" max="2"/>
		</item_modify>
	</event>
</eventList>

<event name="XFTL_PIRATE_DUEL">
	<text id="event_XFTL_PIRATE_DUEL_text"/>
	<choice>
		<text id="event_XFTL_PIRATE_DUEL_c1_choice"/>
		<event>
			<text id="event_XFTL_PIRATE_DUEL_c1_text"/>
			<ship load="XFTL_PIRATE_DUELLIST" hostile="true"/>
		</event>
	</choice>
	<choice>
		<text id="event_XFTL_PIRATE_DUEL_c2_choice"/>
		<event>
			<text id="event_XFTL_PIRATE_DUEL_c2_text"/>
		</event>
	</choice>
</event>
<ship name="XFTL_PIRATE_DUELLIST" auto_blueprint="SHIPS_PIRATE">
	<destroyed>
		<text id="ship_XFTL_PIRATE_DUELLIST_destroyed_text"/>
		<autoReward level="HIGH">standard</autoReward>
	</destroyed>
	<deadCrew>
		<text id="ship_XFTL_PIRATE_DUELLIST_deadCrew_text"/>
		<autoReward level="HIGH">standard</autoReward>
	</deadCrew>
</ship>

