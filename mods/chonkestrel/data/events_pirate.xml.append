			<text id="event_XFTL_PIRATE_TOLL_c2_text"/>
			<ship load="PIRATE" hostile="true"/>
		</event>
	</choice>
	<choice req="cloaking" hidden="true">
		<text id="event_XFTL_PIRATE_TOLL_c3_choice"/>
		<event>
			<text id="event_XFTL_PIRATE_TOLL_c3_text"/>
		</event>
	</choice>
</event>

