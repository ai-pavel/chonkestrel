			<text id="event_XFTL_SLUG_INSURANCE_c2_text"/>
		</event>
	</choice>
</event>
<eventList name="XFTL_SLUG_INSURANCE_OUTCOME">
	<event>
		<text id="event_XFTL_SLUG_INSURANCE_OUTCOME_1_text"/>
		<item_modify>
			<item type="scrap" min="-20" max="-20"/>
		</item_modify>
		<damage amount="-5"/>
	</event>
	<event>
		<text id="event_XFTL_SLUG_INSURANCE_OUTCOME_2_text"/>
		<item_modify>
			<item type="scrap" min="-20" max="-20"/>
		</item_modify>
	</event>
</eventList>

<event name="XFTL_SLUG_SPA">
	<text id="event_XFTL_SLUG_SPA_text"/>
