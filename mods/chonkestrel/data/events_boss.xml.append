</event>

<event name="XFTL_CAPITAL_DEPOT" unique="false">
	<text id="event_XFTL_CAPITAL_DEPOT_text"/>
	<item_modify xftlScale="size">
		<item type="fuel" min="3" max="5"/>
	</item_modify>
</event>

<!-- The capital's own events, one of each a sector -->
<event name="XFTL_CAPITAL_TRAFFIC">
	<text id="event_XFTL_CAPITAL_TRAFFIC_text"/>
	<choice>
		<text id="event_XFTL_CAPITAL_TRAFFIC_c1_choice"/>
		<event>
			<text id="event_XFTL_CAPITAL_TRAFFIC_c1_text"/>
			<ship load="XFTL_CAPITAL_JOINED_SHIP" hostile="true"/>
			<status type="limit" target="enemy" system="shields" amount="1"/>
		</event>
	</choice>
	<choice>
		<text id="event_XFTL_CAPITAL_TRAFFIC_c2_choice"/>
		<event>
			<text id="event_XFTL_CAPITAL_TRAFFIC_c2_text"/>
			<modifyPursuit amount="1"/>
		</event>
	</choice>
</event>

<event name="XFTL_CAPITAL_PARADE">
	<text id="event_XFTL_CAPITAL_PARADE_text"/>
	<choice>
		<text id="event_XFTL_CAPITAL_PARADE_c1_choice"/>
		<event>
			<text id="event_XFTL_CAPITAL_PARADE_c1_text"/>
			<ship load="XFTL_CAPITAL_REBEL_SHIP" hostile="true"/>
			<status type="limit" target="enemy" system="weapons" amount="2"/>
		</event>
	</choice>
	<choice>
		<text id="event_XFTL_CAPITAL_PARADE_c2_choice"/>
		<event>
			<text id="event_XFTL_CAPITAL_PARADE_c2_text"/>
		</event>
	</choice>
</event>

<event name="XFTL_CAPITAL_YARD">
	<text id="event_XFTL_CAPITAL_YARD_text"/>
	<choice>
		<text id="event_XFTL_CAPITAL_YARD_c1_choice"/>
		<event>
			<text id="event_XFTL_CAPITAL_YARD_c1_text"/>
			<ship load="XFTL_CAPITAL_YARD_SHIP" hostile="true"/>
			<status type="limit" target="enemy" system="weapons" amount="1"/>
		</event>
	</choice>
	<choice>
		<text id="event_XFTL_CAPITAL_YARD_c2_choice"/>
		<event>
			<text id="event_XFTL_CAPITAL_YARD_c2_text"/>
		</event>
	</choice>
</event>
<ship name="XFTL_CAPITAL_YARD_SHIP" auto_blueprint="XFTL_HYBRIDS">
