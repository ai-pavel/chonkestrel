</ship>

<event name="XFTL_CAPITAL_ADMIRAL">
	<text id="event_XFTL_CAPITAL_ADMIRAL_text"/>
	<choice>
		<text id="event_XFTL_CAPITAL_ADMIRAL_c1_choice"/>
		<event>
			<text id="event_XFTL_CAPITAL_ADMIRAL_c1_text"/>
			<modifyPursuit amount="-1"/>
		</event>
	</choice>
	<choice>
		<text id="event_XFTL_CAPITAL_ADMIRAL_c2_choice"/>
		<event>
			<text id="event_XFTL_CAPITAL_ADMIRAL_c2_text"/>
			<damage amount="-6" xftlScale="size"/>
