		<text id="event_XFTL_CAPITAL_LOYALISTS_c1_choice"/>
		<event>
			<text id="event_XFTL_CAPITAL_LOYALISTS_c1_text"/>
			<crewMember amount="1" class="human"/>
		</event>
	</choice>
	<choice>
		<text id="event_XFTL_CAPITAL_LOYALISTS_c2_choice"/>
		<event>
			<text id="event_XFTL_CAPITAL_LOYALISTS_c2_text"/>
			<item_modify>
				<item type="missiles" min="4" max="6"/>
			</item_modify>
		</event>
	</choice>
</event>

<event name="XFTL_CAPITAL_CHOIR">
	<text id="event_XFTL_CAPITAL_CHOIR_text"/>
	<choice>
		<text id="event_XFTL_CAPITAL_CHOIR_c1_choice"/>
		<event>
			<text id="event_XFTL_CAPITAL_CHOIR_c1_text"/>
		</event>
	</choice>
	<choice req="crystal" hidden="true">
		<text id="event_XFTL_CAPITAL_CHOIR_c2_choice"/>
		<event>
			<text id="event_XFTL_CAPITAL_CHOIR_c2_text"/>
			<reveal_map/>
		</event>
	</choice>
	<choice req="slug" hidden="true">
		<text id="event_XFTL_CAPITAL_CHOIR_c3_choice"/>
		<event>
			<text id="event_XFTL_CAPITAL_CHOIR_c3_text"/>
			<reveal_map/>
		</event>
	</choice>
</event>

<event name="XFTL_CAPITAL_SAL">
	<text id="event_XFTL_CAPITAL_SAL_text"/>
	<choice>
		<text id="event_XFTL_CAPITAL_SAL_c1_choice"/>
		<event>
			<text id="event_XFTL_CAPITAL_SAL_c1_text"/>
			<ship load="XFTL_CAPITAL_SAL_SHIP" hostile="true"/>
		</event>
	</choice>
	<choice>
		<text id="event_XFTL_CAPITAL_SAL_c2_choice"/>
		<event>
			<text id="event_XFTL_CAPITAL_SAL_c2_text"/>
		</event>
	</choice>
</event>
<ship name="XFTL_CAPITAL_SAL_SHIP" auto_blueprint="XFTL_HYBRIDS">
	<destroyed>
		<text id="ship_XFTL_CAPITAL_SAL_SHIP_destroyed_text"/>
		<autoReward level="HIGH">standard</autoReward>
	</destroyed>
	<deadCrew>
		<text id="ship_XFTL_CAPITAL_SAL_SHIP_deadCrew_text"/>
		<autoReward level="HIGH">standard</autoReward>
	</deadCrew>
</ship>

<!--
    The Mainframe: CONCORD's core, at the far end of the Silent Capital, in
    place of the Federation base and the flagship (see doc/game/mainframe.md).
    Three phases, one after another at its beacon, as CONCORD tries one way
    after another: the Mind, which comes out to talk the crew into the
    Chorus; the Splicing Bays, which build it an army; and the Firewall, the
    shell around its heart, which it hides behind at the last. After each of
    the first two, there's a break of 20 seconds, then the next phase's
    event (XFTL_MAINFRAME_PHASE_<n>, see InGameState.startMainframePhase);
    beating the Firewall wins the game. A phase whose crew are all killed
    fights on, run by CONCORD itself (XFTL_MAINFRAME_AUTOMATED), until it's
    destroyed.
-->
<event name="XFTL_MAINFRAME">
	<text id="event_XFTL_MAINFRAME_text"/>
	<choice>
		<text id="event_XFTL_MAINFRAME_c1_choice"/>
		<event>
			<text id="event_XFTL_MAINFRAME_c1_text"/>
			<ship load="XFTL_MAINFRAME_MIND" hostile="true"/>
		</event>
	</choice>
	<choice req="cloaking" hidden="true">
		<text id="event_XFTL_MAINFRAME_c2_choice"/>
		<event>
			<text id="event_XFTL_MAINFRAME_c2_text"/>
			<xftlBossOpening>ambush</xftlBossOpening>
			<ship load="XFTL_MAINFRAME_MIND" hostile="true"/>
		</event>
	</choice>
</event>

<!-- The first phase: the Mind, CONCORD's voice, come out to talk the crew round -->
<ship name="XFTL_MAINFRAME_MIND" blueprint="XFTL_BOSS_MAINFRAME_MIND">
	<destroyed>
		<text id="ship_XFTL_MAINFRAME_MIND_destroyed_text"/>
	</destroyed>
</ship>

<!-- The second phase: the Splicing Bays -->
<event name="XFTL_MAINFRAME_PHASE_2">
	<text id="event_XFTL_MAINFRAME_PHASE_2_text"/>
	<ship load="XFTL_MAINFRAME_BAYS" hostile="true"/>
</event>
<ship name="XFTL_MAINFRAME_BAYS" blueprint="XFTL_BOSS_MAINFRAME_BAYS">
	<destroyed>
		<text id="ship_XFTL_MAINFRAME_BAYS_destroyed_text"/>
	</destroyed>
</ship>

<!--
    The third and last phase: the Firewall around the Mainframe's heart, one
    of its variants, each the vanilla Rebel flagship with half of a race's
    bomber on either side (see tools/boss_ships.py)
-->
<event name="XFTL_MAINFRAME_PHASE_3">
	<text id="event_XFTL_MAINFRAME_PHASE_3_text"/>
	<ship load="XFTL_MAINFRAME_CORE" hostile="true"/>
</event>
<ship name="XFTL_MAINFRAME_CORE" auto_blueprint="XFTL_BOSS_MAINFRAMES">
	<destroyed>
		<text id="ship_XFTL_MAINFRAME_CORE_destroyed_text"/>
	</destroyed>
</ship>

<!--
    A Mainframe phase whose crew are all killed: CONCORD runs it itself, and
    it fights on, repairing its own systems, until it's destroyed (see
    InGameState.updateOpponents)
-->
<event name="XFTL_MAINFRAME_AUTOMATED">
	<text id="event_XFTL_MAINFRAME_AUTOMATED_text"/>
</event>
