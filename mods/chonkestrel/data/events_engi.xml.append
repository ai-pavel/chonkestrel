<!--
    More events for the vanilla Engi sectors. See sector_data.xml.append.
-->

<eventList name="XFTL_MORE_ENGI">
	<event load="XFTL_ENGI_NANITE_SWARM"/>
	<event load="XFTL_ENGI_LIBRARY"/>
	<event load="XFTL_ENGI_DRONE_FACTORY"/>
	<event load="XFTL_ENGI_ROGUE_AI"/>
</eventList>

<event name="XFTL_ENGI_NANITE_SWARM">
	<text id="event_XFTL_ENGI_NANITE_SWARM_text"/>
	<choice>
		<text id="event_XFTL_ENGI_NANITE_SWARM_c1_choice"/>
		<event load="XFTL_ENGI_NANITE_OUTCOME"/>
	</choice>
	<choice req="engi" hidden="true">
		<text id="event_XFTL_ENGI_NANITE_SWARM_c2_choice"/>
		<event>
			<text id="event_XFTL_ENGI_NANITE_SWARM_c2_text"/>
			<damage amount="-6"/>
		</event>
	</choice>
	<choice>
		<text id="event_XFTL_ENGI_NANITE_SWARM_c3_choice"/>
		<event/>
	</choice>
</event>
<eventList name="XFTL_ENGI_NANITE_OUTCOME">
	<event>
		<text id="event_XFTL_ENGI_NANITE_OUTCOME_1_text"/>
		<damage amount="-4"/>
	</event>
	<event>
		<text id="event_XFTL_ENGI_NANITE_OUTCOME_2_text"/>
		<damage amount="1" system="random"/>
	</event>
	<event>
		<text id="event_XFTL_ENGI_NANITE_OUTCOME_3_text"/>
		<upgrade amount="1" system="reactor"/>
	</event>
</eventList>

<event name="XFTL_ENGI_LIBRARY">
	<text id="event_XFTL_ENGI_LIBRARY_text"/>
	<choice>
		<text id="event_XFTL_ENGI_LIBRARY_c1_choice"/>
		<event>
			<text id="event_XFTL_ENGI_LIBRARY_c1_text"/>
			<drone name="RANDOM"/>
		</event>
	</choice>
	<choice>
		<text id="event_XFTL_ENGI_LIBRARY_c2_choice"/>
		<event>
			<text id="event_XFTL_ENGI_LIBRARY_c2_text"/>
			<reveal_map/>
		</event>
	</choice>
	<choice>
		<text id="event_XFTL_ENGI_LIBRARY_c3_choice"/>
		<event>
			<text id="event_XFTL_ENGI_LIBRARY_c3_text"/>
		</event>
	</choice>
</event>

<event name="XFTL_ENGI_DRONE_FACTORY">
	<text id="event_XFTL_ENGI_DRONE_FACTORY_text"/>
	<choice>
		<text id="event_XFTL_ENGI_DRONE_FACTORY_c1_choice"/>
		<event load="XFTL_ENGI_DRONE_FACTORY_OUTCOME"/>
	</choice>
	<choice req="hacking" hidden="true">
		<text id="event_XFTL_ENGI_DRONE_FACTORY_c2_choice"/>
		<event>
			<text id="event_XFTL_ENGI_DRONE_FACTORY_c2_text"/>
			<item_modify>
				<item type="drones" min="3" max="5"/>
			</item_modify>
		</event>
	</choice>
	<choice>
		<text id="event_XFTL_ENGI_DRONE_FACTORY_c3_choice"/>
		<event/>
	</choice>
</event>
<eventList name="XFTL_ENGI_DRONE_FACTORY_OUTCOME">
	<event>
		<text id="event_XFTL_ENGI_DRONE_FACTORY_OUTCOME_1_text"/>
		<item_modify>
			<item type="drones" min="2" max="4"/>
		</item_modify>
	</event>
	<event>
		<text id="event_XFTL_ENGI_DRONE_FACTORY_OUTCOME_2_text"/>
		<ship load="XFTL_ENGI_FACTORY_GUARD" hostile="true"/>
	</event>
</eventList>
<ship name="XFTL_ENGI_FACTORY_GUARD" auto_blueprint="SHIPS_AUTO">
	<destroyed>
		<text id="ship_XFTL_ENGI_FACTORY_GUARD_destroyed_text"/>
		<item_modify>
			<item type="drones" min="2" max="4"/>
		</item_modify>
		<autoReward level="MED">standard</autoReward>
	</destroyed>
</ship>

<event name="XFTL_ENGI_ROGUE_AI">
	<text id="event_XFTL_ENGI_ROGUE_AI_text"/>
	<choice>
		<text id="event_XFTL_ENGI_ROGUE_AI_c1_choice"/>
		<event>
			<text id="event_XFTL_ENGI_ROGUE_AI_c1_text"/>
			<ship load="XFTL_ENGI_ROGUE_SHIP" hostile="true"/>
		</event>
	</choice>
	<choice req="hacking" hidden="true">
		<text id="event_XFTL_ENGI_ROGUE_AI_c2_choice"/>
		<event>
			<text id="event_XFTL_ENGI_ROGUE_AI_c2_text"/>
			<crewMember amount="1" class="engi"/>
			<autoReward level="LOW">standard</autoReward>
		</event>
	</choice>
	<choice>
		<text id="event_XFTL_ENGI_ROGUE_AI_c3_choice"/>
		<event/>
	</choice>
</event>
<ship name="XFTL_ENGI_ROGUE_SHIP" auto_blueprint="SHIPS_CIRCLE">
	<destroyed>
		<text id="ship_XFTL_ENGI_ROGUE_SHIP_destroyed_text"/>
		<autoReward level="LOW">standard</autoReward>
	</destroyed>
	<deadCrew>
		<text id="ship_XFTL_ENGI_ROGUE_SHIP_deadCrew_text"/>
		<autoReward level="MED">standard</autoReward>
	</deadCrew>
</ship>
