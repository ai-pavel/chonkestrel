<?xml version="1.0" encoding="utf-8"?>
<ui>
    <widget type="free">
        <!-- The frame, with a type section added above the layout one, for
             the Normal and Chonky buttons: the image down to the middle of
             its layout panel (here the type panel), a 16-pixel strip of that
             panel's middle twice (as its pattern repeats every 16 or so),
             the panel's bottom, then the image again from the gap above its
             layout panel (its heading's) to the end -->
        <widget type="image" img="img/customizeUI/box_shipselect.png" h="170"
                pLeft="-6" pRight="-7" pTop="-7"/>
        <widget type="image" img="img/customizeUI/box_shipselect.png" iy="154" h="16"
                pLeft="-6" pRight="-7" pTop="163"/>
        <widget type="image" img="img/customizeUI/box_shipselect.png" iy="154" h="16"
                pLeft="-6" pRight="-7" pTop="179"/>
        <widget type="image" img="img/customizeUI/box_shipselect.png" iy="170" h="15"
                pLeft="-6" pRight="-7" pTop="195"/>
        <widget type="image" img="img/customizeUI/box_shipselect.png" iy="110" h="132"
                pLeft="-6" pRight="-7" pTop="210" pBottom="-7"/>

        <widget type="label" colour="text-dark" font="HL2" scale="2" text="hangar_frame_ship"
                pLeft="13" pTop="6"/>

        <widget type="hbox" pTop="32" pLeft="0" pRight="0">
            <widget type="free" xStretch="1"/>

            <widget type="image-button" select2="img/customizeUI/button_arrow" id="previous_ship"/>

            <widget type="free" w="7"/>

            <widget type="button" id="list">
                <widget type="label" colour="text-dark" font="HL2" scale="2" text="ship_list_button"
                        pLeft="4" pRight="4" pTop="6" pBottom="6"/>
            </widget>

            <widget type="free" w="7"/>

            <widget type="image-button" select2="img/customizeUI/button_arrow" mirror="true" id="next_ship"/>

            <widget type="free" xStretch="1"/>
        </widget>

        <widget type="hbox" pTop="65" pLeft="0" pRight="0">
            <widget type="free" xStretch="1"/>

            <widget type="button" id="random">
                <widget type="label" colour="text-dark" font="HL2" scale="2" text="ship_random_button"
                        pLeft="4" pRight="4" pTop="6" pBottom="6"/>
            </widget>

            <widget type="free" xStretch="1"/>
        </widget>

        <!-- The vanilla ship, or its big version (see
             SelectShipState.counterpartOf), one above the other, as wide
             as the random ship button -->
        <widget type="label" colour="text-dark" font="HL2" scale="2" text="xftl_hangar_type"
                pLeft="13" pTop="108"/>

        <widget type="hbox" pTop="138" pLeft="0" pRight="0">
            <widget type="free" xStretch="1"/>

            <widget type="button" w="152" id="size_normal">
                <widget type="label" colour="text-dark" font="HL2" scale="2" text="xftl_hangar_normal"
                        pLeft="4" pRight="4" pTop="6" pBottom="6"/>
            </widget>

            <widget type="free" xStretch="1"/>
        </widget>

        <widget type="hbox" pTop="171" pLeft="0" pRight="0">
            <widget type="free" xStretch="1"/>

            <widget type="button" w="152" id="size_chonky">
                <widget type="label" colour="text-dark" font="HL2" scale="2" text="xftl_hangar_chonky"
                        pLeft="4" pRight="4" pTop="6" pBottom="6"/>
            </widget>

            <widget type="free" xStretch="1"/>
        </widget>

        <widget type="label" colour="text-dark" font="HL2" scale="2" text="hangar_frame_layout"
                pLeft="13" pTop="215"/>

        <widget type="hbox" pTop="242" pLeft="0" pRight="0">
            <widget type="free" xStretch="1"/>

            <widget type="button" w="36" h="34" id="type_a">
                <widget type="label" colour="text-dark" font="HL2" scale="3" text="typebutton_a"
                        pLeft="0" pRight="0" pTop="5"/>
            </widget>

            <widget type="free" w="9"/>

            <widget type="button" w="36" h="34" id="type_b">
                <widget type="label" colour="text-dark" font="HL2" scale="3" text="typebutton_b"
                        pLeft="0" pRight="0" pTop="5"/>
            </widget>

            <widget type="free" w="9"/>

            <widget type="button" w="36" h="34" id="type_c">
                <widget type="label" colour="text-dark" font="HL2" scale="3" text="typebutton_c"
                        pLeft="0" pRight="0" pTop="5"/>
            </widget>

            <widget type="free" xStretch="1"/>
        </widget>

        <widget type="hbox" pTop="295" pLeft="0" pRight="0">
            <widget type="free" xStretch="1"/>

            <!-- Laid out to fit "show rooms", the wider of its two labels
                 (it's set to "hide rooms" as the hangar opens), as wide as
                 the random ship button, as the type buttons are -->
            <widget type="button" w="152" pTop="0" id="hide_rooms">
                <widget type="label" colour="text-dark" font="HL2" scale="2" text="ship_showrooms_button"
                        pLeft="4" pRight="4" pTop="6" pBottom="6" id="hide_rooms_label"/>
            </widget>

            <widget type="free" xStretch="1"/>
        </widget>

    </widget>

    <style>
    </style>
</ui>
